program pibackup;
{$mode objfpc}{$H+}

uses
  {$IFDEF UNIX}
  cthreads, unix,
  {$ENDIF}
  qtfix,        // 🔥 setzt Environment VOR Qt
  Interfaces,   // Qt wird hier geladen
  Forms,
  Dialogs,
  rkutils,
  unit1,
  exethread,
  UserSetup,
  uitheme,
  Unit2,
  Editor,
  ExcludeProcessor,
  msg_dlg,
  pibackup_updater,
  UpdateDlg;

  {$R *.res}

begin
  RequireDerivedFormResource := True;

  // ===== Root Check =====
  if not RunsAsRoot then
  begin
    MessageDlg('Error',
      'This program requires root privileges.' + LineEnding + 'Please run it using sudo, su, or as the root user.',
      mtError, [mbOK], 0);
    Halt(1);
  end;

  // ===== Kein DPI Scaling =====
  Application.Scaled := True;

  // ===== Qt starten =====
  Application.Initialize;

  // ===== Style + Font setzen =====
  // ApplyCodeTyphonStyle;  // Farben + Fusion Style
  // ApplyFont;             // feste Schrift

  // ===== Form erstellen =====
  Application.CreateForm(TForm1, Form1);
  Application.CreateForm(TForm2, Form2);
  Application.CreateForm(TForm3, Form3);
  Application.CreateForm(TForm4, Form4);
  Application.CreateForm(TForm5, Form5);
  Application.Run;
end.
